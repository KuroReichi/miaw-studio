{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "esnext",
		"types": ["vite/client"],
		"allowArbitraryExtensions": true,
		"skipLibCheck": true,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,

		"paths": {
			"@legiun/*": ["./src/interface/*"],
			"@legiun/auth/*": ["./src/auth/*"],
			"@legiun/firebase/*": ["./src/firebase/*"],
			"@legiun/database": ["./src/firebase/api/database/index.ts"],
			"@legiun/assets/*": ["./src/assets/*"],
			"@legiun/components/*": ["./src/interface/components/*"]
		}
	},
	"include": ["src"]
}
