{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023", "DOM"],
		"module": "esnext",
		"types": ["vite/client"],
		"allowArbitraryExtensions": true,
		"skipLibCheck": true,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,

		"paths": {
			"@legiun/*": ["./src/interface/*"],
			"@legiun/auth/*": ["./src/auth/*"],
			"@legiun/assets/*": ["./src/assets/*"],
			"@legiun/components/*": ["./src/interface/components/*"],
			"@legiun/layout/*": ["./src/interface/layout/*"],
			"@legiun/pages/*": ["./src/interface/pages/*"],
			"@legiun/styles/*": ["./src/interface/styles/*"],
			"@legiun/themes/*": ["./src/interface/themes/*"]
		}
	},
	"include": ["src"]
}
